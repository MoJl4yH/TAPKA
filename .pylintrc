[MASTER]
# Run pylint from the project root so this config file is detected.
ignore=venv,.venv,build,dist,__pycache__,.git,.mypy_cache,.pytest_cache,.ruff_cache,.tapka
ignore-patterns=.*\.pyi$,.*_generated\.py$,.*generated.*\.py$,.*\.pb2\.py$,.*_ui\.py$

jobs=0
recursive=yes
py-version=3.11

[REPORTS]
reports=no
score=yes

[MESSAGES CONTROL]
disable=
    # style/format/naming rules are not blockers for logic refactoring
    C0103,  # invalid-name
    C0114,  # missing-module-docstring
    C0115,  # missing-class-docstring
    C0116,  # missing-function-docstring
    C0301,  # line-too-long
    C0302,  # too-many-lines (can be refactored later; not a repo-wide blocker)
    C0325,  # superfluous-parens
    C0411,  # wrong-import-order
    C0412,  # ungrouped-imports
    C0413,  # wrong-import-position
    R0903,  # too-few-public-methods (acceptable for dataclass/container types)
    R0801,  # duplicate-code (often noisy for similar runners; enable later if needed)

[FORMAT]
max-line-length=120
indent-string='    '

[BASIC]
good-names=i,j,k,x,y,fd,fp,db,id,ok,rc,ts,dt,ex,fn,rv
dummy-variables-rgx=^(_|unused_|.*_unused)$

[TYPECHECK]
ignored-modules=PySide6
ignored-classes=Qt,QObject

[DESIGN]
max-args=8
max-positional-arguments=8
max-locals=30
max-branches=25
max-statements=90
max-returns=10
max-attributes=12
max-public-methods=30
max-bool-expr=8
min-public-methods=0

[REFACTORING]
max-nested-blocks=5

[EXCEPTIONS]
overgeneral-exceptions=builtins.Exception

[SIMILARITIES]
min-similarity-lines=6
ignore-imports=yes
ignore-signatures=yes

[LOGGING]
logging-modules=logging
